{
  "contract": "libfinance",
  "version": "1.0.0",
  "notes": [
    "functions: what users call, the same name, parameters (order and defaults) and meaning in every client language.",
    "wire: the RPC functions a libfinance server serves; clients call only these. `returns` is how the answer is encoded.",
    "target: the data family capability (<namespace>.<method>) that serves a wire function; the server gives the function the target's parameters and exposure policy. null: served by the server itself (ping, describe_capabilities, live quotes) or by nothing yet (get_factor).",
    "types: str | int | bool | date (an ISO day; clients also accept their language's date types) | T? (optional) | list[T] | str_or_list (one string or a list of them).",
    "returns: dataframe = a table (wire: {type: arrow, data: <Arrow IPC>}, or {type: pandas, data: <orient=table JSON>} from the Python service); datetime_index = a list of days; raw = JSON."
  ],
  "wire": {
    "ping": {"target": null, "params": [], "returns": "raw", "note": "{version, data_version, ...}; data_version keys the clients' versioned caches"},
    "describe_capabilities": {"target": null, "params": [], "returns": "raw", "note": "per function: name, api, limits (e.g. clamp_date_window) for the caller's level"},

    "get_trading_calendar": {"target": "calendar.get_trading_calendar", "params": ["market"], "returns": "datetime_index"},
    "get_calendar_coverage": {"target": "calendar.coverage", "params": ["market"], "returns": "raw", "note": "{history_start, confirmed_through, exchanges}"},

    "all_instruments": {"target": "stockinstrument.all_securities", "params": ["type", "as_of", "market"], "returns": "dataframe"},
    "instruments": {"target": "stockinstrument.securities", "params": ["symbols", "as_of"], "returns": "dataframe"},

    "get_price": {"target": "stockdaybar.get_price", "params": ["order_book_ids", "start_date", "end_date", "frequency", "fields", "skip_suspended", "include_now", "adjust_type", "adjust_orig"], "returns": "dataframe", "note": "columns symbol_namespace, trading_code, session_date, fields..."},
    "daybar.dataset_info": {"target": "stockdaybar.dataset_info", "params": ["market"], "returns": "raw"},
    "exfactor.dataset_info": {"target": "exfactor.dataset_info", "params": ["market"], "returns": "raw"},
    "get_ex_factor": {"target": "exfactor.get_ex_factor_by_code", "params": ["order_book_ids", "start_date", "end_date"], "returns": "dataframe"},

    "get_dividends": {"target": "dividend.get_dividends", "params": ["order_book_ids", "start_date", "end_date", "fields", "as_of"], "returns": "dataframe"},
    "get_splits": {"target": "split.get_splits", "params": ["order_book_ids", "start_date", "end_date", "fields", "as_of"], "returns": "dataframe"},
    "get_allotments": {"target": "allotment.get_allotments", "params": ["order_book_ids", "start_date", "end_date", "fields", "as_of"], "returns": "dataframe"},
    "get_spinoffs": {"target": "spinoff.get_spinoffs", "params": ["order_book_ids", "start_date", "end_date", "fields", "as_of"], "returns": "dataframe"},

    "get_pit_financials_ex": {"target": "financialstatement.get_pit_financials_ex", "params": ["order_book_ids", "fields", "start_quarter", "end_quarter", "as_of", "statements"], "returns": "dataframe"},
    "get_factor": {"target": null, "params": ["order_book_ids", "factors", "start_quarter", "end_quarter", "as_of"], "returns": "dataframe", "note": "no server serves it yet"},

    "get_instrument_industry": {"target": "industry.get_instrument_industry", "params": ["order_book_ids", "source", "level", "date"], "returns": "dataframe"},
    "get_index_weights": {"target": "indexweight.get_index_weights_on", "params": ["index_code", "date"], "returns": "dataframe"},
    "get_industry": {"target": "industry.get_industry", "params": ["industry", "source", "date", "market"], "returns": "raw"},
    "get_industry_mapping": {"target": "industry.get_industry_mapping", "params": ["source", "date", "market"], "returns": "dataframe"},
    "get_concept_meta": {"target": "conceptinstrument.all_instruments", "params": ["source", "fields", "market"], "returns": "dataframe"},
    "get_concept_weights": {"target": "conceptweight.get_concept_weights", "params": ["concept_ids", "source", "market", "as_of"], "returns": "dataframe"},

    "get_shares": {"target": "shares.get_shares_panel", "params": ["order_book_ids", "start_date", "end_date", "fields"], "returns": "dataframe"},
    "get_last_quotes": {"target": null, "params": ["order_book_ids"], "returns": "raw", "note": "{order_book_id: quote dict or null}"}
  },
  "functions": [
    {"name": "get_all_trading_dates", "module": "calendar", "params": [{"name": "market", "type": "str", "default": "cn"}], "returns": "list[date]", "wire": ["get_trading_calendar", "get_calendar_coverage"], "client": "calendar: sessions + coverage fetched together, cached a day"},
    {"name": "get_calendar_coverage", "module": "calendar", "params": [{"name": "market", "type": "str", "default": "cn"}], "returns": "{history_start: date, confirmed_through: date}", "wire": ["get_trading_calendar", "get_calendar_coverage"]},
    {"name": "get_trading_dates", "module": "calendar", "params": [{"name": "start_date", "type": "date"}, {"name": "end_date", "type": "date"}, {"name": "market", "type": "str", "default": "cn"}], "returns": "list[date]", "wire": ["get_trading_calendar", "get_calendar_coverage"], "client": "sessions within [start, end]; CalendarCoverageError outside coverage"},
    {"name": "get_previous_trading_date", "module": "calendar", "params": [{"name": "date", "type": "date"}, {"name": "n", "type": "int", "default": 1}, {"name": "market", "type": "str", "default": "cn"}], "returns": "date", "wire": ["get_trading_calendar", "get_calendar_coverage"]},
    {"name": "get_next_trading_date", "module": "calendar", "params": [{"name": "date", "type": "date"}, {"name": "n", "type": "int", "default": 1}, {"name": "market", "type": "str", "default": "cn"}], "returns": "date", "wire": ["get_trading_calendar", "get_calendar_coverage"]},
    {"name": "is_trading_date", "module": "calendar", "params": [{"name": "date", "type": "date"}, {"name": "market", "type": "str", "default": "cn"}], "returns": "bool", "wire": ["get_trading_calendar", "get_calendar_coverage"]},
    {"name": "get_n_trading_dates_until", "module": "calendar", "params": [{"name": "date", "type": "date"}, {"name": "n", "type": "int"}, {"name": "market", "type": "str", "default": "cn"}], "returns": "list[date]", "wire": ["get_trading_calendar", "get_calendar_coverage"]},
    {"name": "count_trading_dates", "module": "calendar", "params": [{"name": "start_date", "type": "date"}, {"name": "end_date", "type": "date"}, {"name": "market", "type": "str", "default": "cn"}], "returns": "int", "wire": ["get_trading_calendar", "get_calendar_coverage"]},

    {"name": "all_instruments", "module": "instrument", "params": [{"name": "type", "type": "str_or_list?", "default": null}, {"name": "as_of", "type": "date?", "default": null}, {"name": "market", "type": "str?", "default": null}, {"name": "cached", "type": "bool", "default": true}], "returns": "dataframe", "wire": ["all_instruments"], "client": "type aliases STOCK->CS, INDEX->INDX; only CS / INDX; order_book_id first; cached by data_version when market is omitted"},
    {"name": "instruments", "module": "instrument", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "as_of", "type": "date?", "default": null}], "returns": "Instrument? (one code) | list[Instrument] (a list; unknown codes skipped, input order)", "wire": ["instruments"]},

    {"name": "get_price", "module": "price", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "start_date", "type": "date"}, {"name": "end_date", "type": "date"}, {"name": "frequency", "type": "str", "default": "1d"}, {"name": "fields", "type": "str_or_list?", "default": null}, {"name": "skip_suspended", "type": "bool", "default": false}, {"name": "include_now", "type": "bool", "default": true}, {"name": "adjust_type", "type": "str", "default": "pre"}, {"name": "adjust_orig", "type": "date?", "default": null}], "returns": "dataframe indexed (order_book_id, datetime)", "wire": ["all_instruments", "get_price"], "client": "frequency 1d only; adjust_type in pre/post/none; codes classified with all_instruments as of end_date (unknown dropped with a warning); fields checked against the daybar fields; start_date before 2000-01-04 moved up; order_book_id = trading_code.symbol_namespace, datetime = session_date"},
    {"name": "get_price_coverage", "module": "price", "params": [{"name": "market", "type": "str", "default": "cn"}], "returns": "{mic: {start, end, raw_end, adjust_cutoff?}}", "wire": ["daybar.dataset_info", "exfactor.dataset_info"], "client": "end = min(coverage_end, exfactor cutoff); cached by data_version"},

    {"name": "get_dividends", "module": "corporate_actions", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "start_date", "type": "date?", "default": null}, {"name": "end_date", "type": "date?", "default": null}, {"name": "fields", "type": "str_or_list?", "default": null}, {"name": "as_of", "type": "date?", "default": null}], "returns": "dataframe", "wire": ["get_dividends"]},
    {"name": "get_splits", "module": "corporate_actions", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "start_date", "type": "date?", "default": null}, {"name": "end_date", "type": "date?", "default": null}, {"name": "fields", "type": "str_or_list?", "default": null}, {"name": "as_of", "type": "date?", "default": null}], "returns": "dataframe", "wire": ["get_splits"]},
    {"name": "get_allotments", "module": "corporate_actions", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "start_date", "type": "date?", "default": null}, {"name": "end_date", "type": "date?", "default": null}, {"name": "fields", "type": "str_or_list?", "default": null}, {"name": "as_of", "type": "date?", "default": null}], "returns": "dataframe", "wire": ["get_allotments"]},
    {"name": "get_spinoffs", "module": "corporate_actions", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "start_date", "type": "date?", "default": null}, {"name": "end_date", "type": "date?", "default": null}, {"name": "fields", "type": "str_or_list?", "default": null}, {"name": "as_of", "type": "date?", "default": null}], "returns": "dataframe", "wire": ["get_spinoffs"]},

    {"name": "get_ex_factor", "module": "exfactor", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "start_date", "type": "date?", "default": null}, {"name": "end_date", "type": "date?", "default": null}], "returns": "dataframe", "wire": ["get_ex_factor"]},

    {"name": "get_pit_financials_ex", "module": "financials", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "fields", "type": "str_or_list"}, {"name": "start_quarter", "type": "str"}, {"name": "end_quarter", "type": "str"}, {"name": "as_of", "type": "date?", "default": null}, {"name": "statements", "type": "str", "default": "latest"}], "returns": "dataframe", "wire": ["get_pit_financials_ex"], "client": "quarters like 2026q1 (dashes dropped, lower-cased); statements in latest/all"},
    {"name": "get_factor", "module": "financials", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "factors", "type": "str_or_list"}, {"name": "start_quarter", "type": "str"}, {"name": "end_quarter", "type": "str"}, {"name": "as_of", "type": "date?", "default": null}], "returns": "dataframe", "wire": ["get_factor"]},

    {"name": "get_instrument_industry", "module": "index_components", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "date", "type": "date?", "default": null}, {"name": "source", "type": "str", "default": "sw"}, {"name": "level", "type": "int", "default": 1}], "returns": "dataframe", "wire": ["get_instrument_industry"]},
    {"name": "get_index_weights", "module": "index_components", "params": [{"name": "index_code", "type": "str"}, {"name": "date", "type": "date?", "default": null}], "returns": "dataframe", "wire": ["get_index_weights"]},
    {"name": "get_industry", "module": "industry", "params": [{"name": "industry", "type": "str"}, {"name": "source", "type": "str", "default": "sw"}, {"name": "date", "type": "date?", "default": null}, {"name": "market", "type": "str?", "default": null}], "returns": "raw", "wire": ["get_industry"]},
    {"name": "get_industry_mapping", "module": "industry", "params": [{"name": "source", "type": "str", "default": "sw"}, {"name": "date", "type": "date?", "default": null}, {"name": "market", "type": "str?", "default": null}], "returns": "dataframe", "wire": ["get_industry_mapping"]},
    {"name": "get_concept_meta", "module": "concept_components", "params": [{"name": "source", "type": "str", "default": "THS"}, {"name": "fields", "type": "str_or_list?", "default": null}, {"name": "market", "type": "str?", "default": null}], "returns": "dataframe", "wire": ["get_concept_meta"], "client": "cached by data_version"},
    {"name": "get_concept_weights", "module": "concept_components", "params": [{"name": "concept_ids", "type": "list[str]"}, {"name": "as_of", "type": "date?", "default": null}, {"name": "source", "type": "str", "default": "THS"}, {"name": "market", "type": "str?", "default": null}], "returns": "dataframe", "wire": ["get_concept_meta", "get_concept_weights"], "client": "warns on concept ids missing from get_concept_meta"},

    {"name": "get_shares", "module": "shares", "params": [{"name": "order_book_ids", "type": "str_or_list"}, {"name": "start_date", "type": "date?", "default": null}, {"name": "end_date", "type": "date?", "default": null}, {"name": "fields", "type": "str_or_list?", "default": null}], "returns": "dataframe", "wire": ["get_shares"], "client": "fields within total, total_a, circulation_a, non_circulation_a, free_circulation, preferred_shares"},

    {"name": "get_last_quotes", "module": "live_quote", "params": [{"name": "order_book_ids", "type": "list[str]"}], "returns": "{order_book_id: Quote?}", "wire": ["get_last_quotes"]}
  ]
}
